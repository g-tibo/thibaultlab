<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{% if (title or name) and (title or name) != site.title %}{{ title or name }} | {% endif %}{{ site.title }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ env.siteUrl }}{{ page.url }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.title }}">
<meta property="og:title" content="{{ title or name or site.title }}">
<meta property="og:description" content="{{ description or site.description }}">
<meta property="og:url" content="{{ env.siteUrl }}{{ page.url }}">
<meta property="og:image" content="{{ env.siteUrl }}/assets/img/og-image.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="Thibault Lab logo">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or name or site.title }}">
<meta name="twitter:description" content="{{ description or site.description }}">
<meta name="twitter:image" content="{{ env.siteUrl }}/assets/img/og-image.png">
<meta name="theme-color" content="#EEF1EC">
<meta name="color-scheme" content="light dark">
<link rel="icon" href="/assets/img/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicon-32.png">
<link rel="icon" type="image/png" sizes="192x192" href="/assets/img/icon-192.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/site.css">
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header class="top">
  <div class="top-in">
    <a class="brand" href="/">Thibault Lab</a>
    <button class="menu-btn" id="menuBtn" aria-expanded="false" aria-controls="nav" type="button">Menu</button>
    <nav class="nav" id="nav" aria-label="Main">
      {% for item in site.nav %}<a href="{{ item.url }}"{% if navkey == item.label | lower %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {% endfor %}
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer>
  <div class="wrap">
    <div>
      <a class="ntu" href="https://www.ntu.edu.sg/" aria-label="Nanyang Technological University, Singapore"><img src="/assets/img/ntu-logo-white.png" alt="Nanyang Technological University, Singapore" width="520" height="191"></a>
      <h2>Thibault Lab</h2>
      <p>{{ site.address }}<br>{{ site.city }}<br><a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
    <div>
      <div class="social">
        <a class="ib round" href="{{ site.linkedin }}" aria-label="LinkedIn">{{ icons.linkedin | safe }}</a>
        <a class="ib round" href="{{ site.youtube }}" aria-label="YouTube">{{ icons.youtube | safe }}</a>
        <a class="ib round" href="{{ site.bluesky }}" aria-label="Bluesky">{{ icons.bluesky | safe }}</a>
      </div>
      <p>© 2013-{{ "" | currentYear }} Thibault Lab</p>
    </div>
  </div>
</footer>
<script src="/assets/js/site.js" defer></script>
{% for s in scripts %}<script src="{{ s }}" defer></script>
{% endfor %}
{% if site.goatcounter %}<script data-goatcounter="https://{{ site.goatcounter }}.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>{% endif %}
</body>
</html>
