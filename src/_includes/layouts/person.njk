---
layout: layouts/base.njk
navkey: people
---
<div class="wrap">
  <div class="person">
    <aside class="pside">
      <p class="back"><a href="/people/">Back to the team</a></p>
      <div class="ph"><img src="/assets/people/{{ photo }}" alt="{{ name }}" width="400" height="400"></div>
    </aside>
    <div>
      <h1>{{ name }}</h1>
      <p class="role">{{ role }}</p>
      {% if credentials %}<div class="creds">{% for c in credentials %}<p>{{ c | safe }}</p>{% endfor %}</div>{% endif %}
      {% set items = ([{ label: "Email", url: "mailto:" + email }] if email else []).concat(links or []) %}
      {% if items.length %}{% include "partials/profile-links.njk" %}{% endif %}
      <div class="prose">{{ content | safe }}</div>
    </div>
  </div>
</div>
