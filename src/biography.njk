---
layout: layouts/base.njk
title: Biography
navkey: biography
permalink: /biography/
description: Biography of Guillaume Thibault, Associate Professor at the School of Biological Sciences, Nanyang Technological University.
---
{% set b = biography %}
<div class="wrap">
  <div class="person">
    <aside class="pside">
      <p class="back"><a href="/people/">Back to the team</a></p>
      <div class="ph"><img src="/assets/people/{{ b.photo }}" alt="Guillaume Thibault" width="400" height="400"></div>
    </aside>
    <div>
      <h1>{{ b.name }}</h1>
      <p class="role">{{ b.role }}</p>
      <div class="creds addr">{% for l in b.address %}<p>{{ l | safe }}</p>{% endfor %}</div>
      {% set items = b.links %}
      {% include "partials/profile-links.njk" %}
      <div class="prose" style="margin-top:28px">{% for p in b.intro %}<p>{{ p | safe }}</p>{% endfor %}</div>
      {% for s in b.sections %}
      <h2>{{ s.title }}</h2>
      <div class="prose">
        {% if s.title == "Publications" %}<p class="bline"><a href="/publications/">Publications on this site</a></p>{% endif %}
        {% for r in s.rows %}
          {% if r.subhead %}<div class="bsub">{{ r.subhead | safe }}</div>
          {% elif r.date %}<div class="brow"><span class="d">{{ r.date }}</span><span>{{ r.text | safe }}</span></div>
          {% else %}<p class="bline">{{ r.text | safe }}</p>{% endif %}
        {% endfor %}
      </div>
      {% endfor %}
    </div>
  </div>
</div>
